# =========================================================
# StoneKrusher / KONSTRUCTZ - Environment Configuration Example
# Copy this file to .env and fill in values for your environment.
# Never commit credentials or secret values to version control.
# =========================================================

# Database Configuration (MySQL for Production / Hostinger, SQLite for Local Dev)
DB_DRIVER=sqlite
DB_FILE=data/site.db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_database_user
DB_PASS=your_database_password

# CMS Security & Session Settings
CMS_MAX_FAILED_LOGINS=10
CMS_LOCKOUT_DURATION_MINUTES=15
CMS_SESSION_LIFETIME_HOURS=8
CMS_AUDIT_LOG_RETENTION_DAYS=90

# CSRF & Security Salt
CMS_CSRF_SALT=replace_with_a_secure_random_string_32_characters_min

# Initial Admin Provisioning (used once if cms_users table is empty)
CMS_INITIAL_ADMIN_USERNAME=admin
CMS_INITIAL_ADMIN_EMAIL=admin@example.com
CMS_INITIAL_ADMIN_PASSWORD=change_this_initial_password_before_setup!

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Site Details
SITE_NAME="KONSTRUCTZ Machinery"
SITE_URL="https://stonekrusher.com"
ADMIN_EMAIL="sales@example.com"

# Local Vite Dev Proxy target
VITE_API_BACKEND="http://127.0.0.1:8008"
